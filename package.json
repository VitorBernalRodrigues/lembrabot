{
  "name": "lembrabot",
  "version": "1.0.0",
  "description": "Discord bot for reminders and polls, built with slash commands, TypeScript and SQLite.",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "typescript",
    "sqlite",
    "reminders",
    "polls"
  ],
  "homepage": "https://github.com/VitorBernalRodrigues/lembrabot#readme",
  "bugs": {
    "url": "https://github.com/VitorBernalRodrigues/lembrabot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitorBernalRodrigues/lembrabot.git"
  },
  "license": "MIT",
  "author": "Vitor Bernal Rodrigues",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
