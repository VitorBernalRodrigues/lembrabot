# Bot token (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Discord Developer Portal > General Information)
DISCORD_CLIENT_ID=
# Optional: a test guild ID. When set, commands are registered instantly to that
# guild only. When empty, commands are registered globally.
DISCORD_GUILD_ID=
# SQLite database file path
DATABASE_PATH=./data/lembrabot.db
# How often (in seconds) the scheduler checks for due reminders
REMINDER_CHECK_INTERVAL_SECONDS=15
